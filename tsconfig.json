{
    "compilerOptions": {
        "target": "ESNext",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "skipLibCheck": true,
        "strict": true,
        "sourceMap": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "lib": ["DOM", "DOM.Iterable", "ESNext"],
        "rootDir": ".",
        "typeRoots": ["./types", "./node_modules/@types"],
        "paths": {
            "@client/*": ["./src/client/*"],
            "@server/*": ["./src/server/*"]
        }
    },
    "include": ["./vite.config.ts"]
}
